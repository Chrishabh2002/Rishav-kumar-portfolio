# Copy to .env and fill in real values. Never commit .env itself.

# Cosmic platform
USER_ID=
NEXT_PUBLIC_CLIENT_ID=
COSMICAUTH_SECRET=
COSMIC_PAYMENTS_SECRET=
COSMIC_DATABASE_SECRET=
COSMIC_FILES_SECRET=

# Public site URL, used for metadata and Open Graph tags
NEXT_PUBLIC_BASE_URL=

# Optional — powers the on-site AI assistant.
# With neither key set, the assistant falls back to a built-in résumé answer engine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
